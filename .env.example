# ============================================================
# CH PROJECT — пример файла окружения.
# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env НИКОГДА не публикуется и не попадает в Git.
# ============================================================

# --- Telegram: куда приходят заявки (обязательно) ---
# Токен получаете у @BotFather, chat_id — у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Можно указать несколько получателей через запятую: 123456789,987654321

# --- Порт backend-а приёма заявок ---
PORT=3001

# --- Аналитика (вставляются в HTML, продублировано для справки) ---
YANDEX_METRIKA_ID=
YANDEX_WEBMASTER_VERIFICATION=

# --- На будущее: CRM ---
CRM_API_URL=
CRM_API_KEY=

# --- На будущее: AI-квалификация заявок ---
AI_API_KEY=
